<Window x:Class="NutritionCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nutrition Calculator" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="Food Nutrition Calculator" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"
                       Foreground="#333"/>
            
            <!-- Input Section -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Food Selection -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Select Food:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontSize="14"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          Name="FoodComboBox"
                          Height="35"
                          Padding="10"
                          FontSize="12"/>
                
                <!-- Amount Input -->
                <TextBlock Grid.Row="0" Grid.Column="2" 
                           Text="Amount (g):" 
                           VerticalAlignment="Center"
                           Margin="20,0,10,0"
                           FontSize="14"/>
                <TextBox Grid.Row="0" Grid.Column="3" 
                         Name="AmountTextBox"
                         Height="35"
                         Padding="10"
                         FontSize="12"
                         VerticalContentAlignment="Center"/>
                
                <!-- Calculate Button -->
                <Button Grid.Row="0" Grid.Column="4" 
                        Name="CalculateButton"
                        Content="Calculate"
                        Height="35"
                        Width="100"
                        Margin="20,0,0,0"
                        Background="#4CAF50"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        Click="CalculateButton_Click"
                        Cursor="Hand"/>
            </Grid>
            
            <!-- Results Section -->
            <Border BorderBrush="#DDD" BorderThickness="1" Padding="20" Background="White" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Results:" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               Foreground="#333"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Energy Result -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Energy" 
                                       FontSize="12" 
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Name="EnergyResult"
                                       Text="0 kcal"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FF6B6B"/>
                        </StackPanel>
                        
                        <!-- Protein Result -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Protein" 
                                       FontSize="12" 
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Name="ProteinResult"
                                       Text="0 g"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#4ECDC4"/>
                        </StackPanel>
                        
                        <!-- Fat Result -->
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Fat" 
                                       FontSize="12" 
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Name="FatResult"
                                       Text="0 g"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFE66D"/>
                        </StackPanel>
                        
                        <!-- Carbohydrates Result -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Carbohydrates" 
                                       FontSize="12" 
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Name="CarbohydratesResult"
                                       Text="0 g"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#95E1D3"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>